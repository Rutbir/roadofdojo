<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#4DFFFFFF"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvEvalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evaluasi Latihan"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Setelah latihan gerakan ini, apakah kamu sudah merasa menguasai gerakan ini?"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEvalKurang"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Masih Kaku (Butuh Latihan Lagi)"
                android:textColor="#FF5252"
                android:textSize="14sp"
                app:backgroundTint="#33FF5252"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FF5252"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEvalLumayan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Lumayan (Udah Mulai Lancar)"
                android:textColor="#FF9800"
                android:textSize="14sp"
                app:backgroundTint="#33FF9800"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FF9800"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEvalMantap"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="GG Banget (Sudah Menguasai)"
                android:textColor="#121212"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FFD700"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>