<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- HEADER: PLACEHOLDER VIDEO/GAMBAR GERAKAN BOXING -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- Gambar background Boxing -->
            <ImageView
                android:id="@+id/imgGerakanDemo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/boxing"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Efek gelap biar play button kelihatan -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000" />

            <!-- Icon Play (Kesan video tutorial interaktif) -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFD700"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- KONTEN UTAMA: OVERLAPPING CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="-40dp"> <!-- Kunci efek card melayang -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#1A1A1A"
                app:strokeWidth="1dp"
                app:strokeColor="#33FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- JUDUL & BADGE LEVEL -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/tvGerakanTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@+id/cardLevel"
                            android:layout_marginEnd="12dp"
                            android:text="Nama Gerakan"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_centerVertical="true"/>

                        <!-- Badge Level Dinamis -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:cardBackgroundColor="#FFD700"
                            app:cardCornerRadius="8dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/tvLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BEGINNER"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#121212"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>
                        </com.google.android.material.card.MaterialCardView>

                    </RelativeLayout>

                    <!-- Garis Pemisah Elegan -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#33FFFFFF"
                        android:layout_marginBottom="20dp"/>

                    <!-- BAGIAN DESKRIPSI & INSTRUKSI -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cara Melakukan:"
                        android:textColor="#FFD700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Teks placeholder ini nanti diganti otomatis dari Kotlin -->
                    <TextView
                        android:id="@+id/tvGerakanDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Posisikan tubuh dalam stance boxing.\n2. Jaga guard tangan tetap di depan wajah.\n3. Putar pinggul dan pundak bersamaan.\n4. Lontarkan pukulan lurus ke target.\n5. Tarik kembali tangan secepat kilat."
                        android:textColor="#CCCCCC"
                        android:lineSpacingExtra="8dp"
                        android:textSize="14sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TOMBOL AKSI SELESAI LATIHAN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelesaiLatihan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Tandai Selesai"
                android:textColor="#121212"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#FFD700"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>