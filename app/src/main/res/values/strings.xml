    <!-- Info Khusus Boxing -->
    <string name="title_sweet_science">The Sweet Science</string>
    <string name="desc_sweet_science">Tinju (Boxing) bukan sekadar adu fisik, melainkan seni bela diri yang mengandalkan strategi, gerak kaki (footwork), dan ketepatan. Dikenal sebagai \'The Sweet Science\' karena memperhitungkan tiap pukulan dengan sangat matematis.</string>
